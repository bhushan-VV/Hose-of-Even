{% doc %}
  @prompt
    I need a slider from right to left. with this content:
    
    BLACK FRIDAY - Early Access 
    
    Flat 30% DISCOUNT SITEWIDE
    
    FREE SHIPPING above $100
    
    
    The background should be in back and test in white. 
    
    Please take care of the website don'r scroll right and left. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-slider-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .ai-announcement-slider__wrapper-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    animation: ai-slide-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
  }

  .ai-announcement-slider__content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    padding: {{ block.settings.vertical_padding }}px 0;
    white-space: nowrap;
  }

  .ai-announcement-slider__item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    padding: 0 {{ block.settings.item_spacing | divided_by: 2 }}px;
  }

  .ai-announcement-slider__separator-{{ ai_gen_id }} {
    width: 4px;
    height: 4px;
    background-color: {{ block.settings.text_color }};
    border-radius: 50%;
    opacity: 0.5;
  }

  @keyframes ai-slide-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-announcement-slider__wrapper-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-slider__item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-announcement-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-announcement-slider__wrapper-{{ ai_gen_id }}">
    <div class="ai-announcement-slider__content-{{ ai_gen_id }}">
      {% if block.settings.item_1 != blank %}
        <div class="ai-announcement-slider__item-{{ ai_gen_id }}">
          {{ block.settings.item_1 }}
        </div>
        <span class="ai-announcement-slider__separator-{{ ai_gen_id }}"></span>
      {% endif %}

      {% if block.settings.item_2 != blank %}
        <div class="ai-announcement-slider__item-{{ ai_gen_id }}">
          {{ block.settings.item_2 }}
        </div>
        <span class="ai-announcement-slider__separator-{{ ai_gen_id }}"></span>
      {% endif %}

      {% if block.settings.item_3 != blank %}
        <div class="ai-announcement-slider__item-{{ ai_gen_id }}">
          {{ block.settings.item_3 }}
        </div>
        <span class="ai-announcement-slider__separator-{{ ai_gen_id }}"></span>
      {% endif %}

      {% if block.settings.item_4 != blank %}
        <div class="ai-announcement-slider__item-{{ ai_gen_id }}">
          {{ block.settings.item_4 }}
        </div>
        <span class="ai-announcement-slider__separator-{{ ai_gen_id }}"></span>
      {% endif %}
    </div>

    <div class="ai-announcement-slider__content-{{ ai_gen_id }}" aria-hidden="true">
      {% if block.settings.item_1 != blank %}
        <div class="ai-announcement-slider__item-{{ ai_gen_id }}">
          {{ block.settings.item_1 }}
        </div>
        <span class="ai-announcement-slider__separator-{{ ai_gen_id }}"></span>
      {% endif %}

      {% if block.settings.item_2 != blank %}
        <div class="ai-announcement-slider__item-{{ ai_gen_id }}">
          {{ block.settings.item_2 }}
        </div>
        <span class="ai-announcement-slider__separator-{{ ai_gen_id }}"></span>
      {% endif %}

      {% if block.settings.item_3 != blank %}
        <div class="ai-announcement-slider__item-{{ ai_gen_id }}">
          {{ block.settings.item_3 }}
        </div>
        <span class="ai-announcement-slider__separator-{{ ai_gen_id }}"></span>
      {% endif %}

      {% if block.settings.item_4 != blank %}
        <div class="ai-announcement-slider__item-{{ ai_gen_id }}">
          {{ block.settings.item_4 }}
        </div>
        <span class="ai-announcement-slider__separator-{{ ai_gen_id }}"></span>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement slider",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "item_1",
      "label": "Item 1",
      "default": "BLACK FRIDAY - Early Access"
    },
    {
      "type": "text",
      "id": "item_2",
      "label": "Item 2",
      "default": "Flat 30% DISCOUNT SITEWIDE"
    },
    {
      "type": "text",
      "id": "item_3",
      "label": "Item 3",
      "default": "FREE SHIPPING above $100"
    },
    {
      "type": "text",
      "id": "item_4",
      "label": "Item 4",
      "default": "DELIVERY ACROSS AUSTRALIA"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "min": 8,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Item spacing",
      "default": 40
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Speed",
      "default": 30,
      "info": "Lower is faster"
    }
  ],
  "presets": [
    {
      "name": "Announcement slider"
    }
  ]
}
{% endschema %}
