      "info": "825 x 1100px recommended"
    },
    {
      "id": "image-display-type",
      "label": "Image aspect ratio",
      "type": "select",
      "options": [
        {
          "label": "Original aspect ratio",
          "value": "original"
        },
        {
          "label": "Adjustable aspect ratio",
          "value": "aspect-ratio"
        },
        {
          "label": "Extra small",
          "value": "x-small"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        },
        {
          "label": "Fit screen",
          "value": "fit-screen"
        }
      ],
      "default": "fit-screen"
    },
    {
      "id": "aspect-ratio",
      "label": "Adjustable aspect ratio",
      "type": "range",
      "min": 24,
      "max": 200,
      "step": 2,
      "default": 56,
      "visible_if": "{{ section.settings.image-display-type == 'aspect-ratio' }}"
    },
    {
      "id": "mobile-image-display-type",
      "label": "Mobile image aspect ratio",
      "type": "select",
      "options": [
        {
          "label": "Original aspect ratio",
          "value": "original"
        },
        {
          "label": "Adjustable aspect ratio",
          "value": "aspect-ratio"
        },
        {
          "label": "Extra small",
          "value": "x-small"
        },
        {
          "label": "Small",
          "value": "small"
        },
        {
          "label": "Medium",
          "value": "medium"
        },
        {
          "label": "Large",
          "value": "large"
        },
        {
          "label": "Extra large",
          "value": "x-large"
        },
        {
          "label": "Fit screen",
          "value": "fit-screen"
        }
      ],
      "default": "large"
    },
    {
      "id": "mobile-aspect-ratio",
      "label": "Mobile adjustable aspect ratio",
      "type": "range",
      "min": 32,
      "max": 200,
      "step": 2,
      "default": 134,
      "visible_if": "{{ section.settings.mobile-image-display-type == 'aspect-ratio' }}"
    },
    {
      "type": "header",
      "content": "Foreground"
    },
    {
      "type": "radio",
      "id": "fg-type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "text", "label": "Text" }
      ],
      "default": "text",
      "label": "Type"
    },
    {
      "type": "header",
      "content": "Image options"
    },
    {
      "type": "image_picker",
      "id": "fg-image",
      "label": "Image"
    },
    {
      "label": "Image max-width",
      "id": "fg-image-width",
      "type": "range",
      "min": 100,
      "max": 800,
      "step": 25,
      "unit": "px",
      "default": 500,
      "info": "This is referring to the natural width and should be half the width of the image you uploaded to ensure it stays sharp on retina screens."
    },
    {
      "label": "Mobile image max-width",
      "id": "fg-mobile-image-width",
      "type": "range",
      "min": 100,
      "max": 600,
      "step": 25,
      "unit": "px",
      "default": 300
    },
    {
      "type": "header",
      "content": "Text options"
    },
    {
      "id": "text-width",
      "label": "Text width",
      "type": "range",
      "min": 300,
