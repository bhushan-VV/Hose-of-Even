{%- liquid
  assign aspect_ratio = 100.0 | divided_by: section.settings.aspect-ratio
  assign bg_image = section.settings.bg-image
  assign description = section.settings.description
  assign display_type = section.settings.image-display-type
  assign fg_type = section.settings.fg-type
  assign fg_image = section.settings.fg-image
  assign fg_image_width = section.settings.fg-image-width
  assign fg_mobile_image_width = section.settings.fg-mobile-image-width
  assign highlight_type = section.settings.highlight-type
  assign highlight_color = section.settings.highlight-color
  assign highlight_text = section.settings.highlight-text
  assign link_text = section.settings.link-text
  assign link_url = section.settings.link-url
  assign mobile_aspect_ratio = 100.0 | divided_by: section.settings.mobile-aspect-ratio
  assign mobile_bg_image = section.settings.mobile-bg-image
  assign mobile_display_type = section.settings.mobile-image-display-type
  assign mobile_hide_description = section.settings.mobile-hide-description
  assign mobile_text_x_alignment = section.settings.mobile-text-horizontal-alignment
  assign mobile_text_y_alignment = section.settings.mobile-text-vertical-alignment
  assign overlay_style = section.settings.overlay-style
  assign overline = section.settings.overline
  assign text_bg_color = section.settings.text-background-color
  assign text_style = section.settings.text-style
  assign text_width = section.settings.text-width
  assign text_x_alignment = section.settings.text-horizontal-alignment
  assign text_y_alignment = section.settings.text-vertical-alignment
  assign title = section.settings.title
  assign white_text = section.settings.white-text
-%}

{%- if request.page_type == 'index' -%}
  <div
    class="banner--root"
    data-section-id="{{ section.id }}"
    data-section-type="index_banner"
    data-container-width="6"
    data-mobile-full-width="true"
    data-mobile-spacing-above="none"
    data-mobile-spacing-below="none"
    data-mobile-full-width="true"
    data-spacing-above="none"
    data-spacing-below="none"
  >
    <div class="banner--wrapper">
      {%- if bg_image -%}
        {%-
          render 'image',
          image: bg_image,
          aspect_ratio: aspect_ratio,
          display_type: display_type,
          full_width: true,
          mobile_aspect_ratio: mobile_aspect_ratio,
          mobile_display_type: mobile_display_type,
          mobile_full_width: true,
          mobile_image: mobile_bg_image,
          overlay_style: overlay_style,
          parallax: true,
          sizes: '100vw'
        -%}
      {%- else -%}
        {%-
          render 'placeholder',
          type: 'lifestyle',
          aspect_ratio: aspect_ratio,
          display_type: display_type,
          full_width: true,
          mobile_aspect_ratio: mobile_aspect_ratio,
          mobile_display_type: mobile_display_type,
          mobile_full_width: true,
          overlay_style: overlay_style,
          parallax: true,
          placeholder_index: 2
        -%}
      {%- endif -%}

      <div class="banner--foreground-container">
        {%- if fg_type == 'text' -%}
          {%-
            render 'stacked-text',
            bg_color: text_bg_color,
            cover_link: false,
            description: description,
            heading_type: 'banner-heading',
            highlight_color: highlight_color,
            highlight_text: highlight_text,
            highlight_type: highlight_type,
            id: section.id,
            white_text: white_text,
            link_text: link_text,
            link_url: link_url,
            mobile_hide_description: mobile_hide_description,
            mobile_x_alignment: mobile_text_x_alignment,
            mobile_y_alignment: mobile_text_y_alignment,
            overline: overline,
            style: text_style,
            title: title,
            width: text_width,
            x_alignment: text_x_alignment,
            y_alignment: text_y_alignment
          -%}

        {%- elsif fg_type == 'image' and fg_image != blank -%}
          <div
            class="banner--foreground-image"
            style="--fg-width:{{ fg_image_width }}px;--fg-mobile-width:{{ fg_mobile_image_width }}px;"
          >
            {{-
              fg_image |
              image_url: width: fg_image.width |
              image_tag:
                widths: "300, 500, 800, 1000, 1200, 1500, 1800, 2100, 2400, 3000",
                sizes: '100vw'
            -}}
          </div>

        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Banner",
  "class": "section--banner",
  "settings": [
    {
      "type": "paragraph",
      "content": "Only appears on the home page"
    },
    {
      "type": "header",
